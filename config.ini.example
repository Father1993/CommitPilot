# Copy to config.ini in the CommitPilot directory

[DEFAULT]
api_provider = aitunnel

# Token: prefer .env (AI_TUNNEL=...) over aitunnel_token here
aitunnel_token =
aitunnel_base_url = https://api.aitunnel.ru/v1/
aitunnel_model = gpt-4.1

huggingface_token =
openai_token =

# Legacy field (kept for existing configs; push uses current branch or -b)
branch = master
max_diff_size = 7000
