# Copy to config.ini in the CommitPilot directory

[DEFAULT]
# openai_compatible | openai | huggingface
api_provider = openai_compatible

# OpenAI-compatible API (any host: OpenRouter, RouterAI, local gateway, …)
# Token: prefer .env (API_TOKEN=...) over api_token here
api_token =
api_base_url = https://api.openai.com/v1
api_model = gpt-4.1

huggingface_token =
openai_token =

# Legacy field (kept for existing configs; push uses current branch or -b)
branch = master
max_diff_size = 7000
